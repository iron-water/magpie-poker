{
  "name": "magpie-poker",
  "version": "0.3.0",
  "description": "Multiplayer Texas Hold'em inside magpie: tables over Tailscale, chips settled with magpie gateway keys.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "bin",
    "web",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "go.mod",
    "cmd",
    "internal"
  ],
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "texas-holdem",
    "poker",
    "tailscale"
  ],
  "license": "MIT",
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "magpie": {
    "icon": "assets/icon.svg",
    "page": {
      "title": "Poker",
      "titles": {
        "zh": "牌桌",
        "zh-TW": "牌桌",
        "ja": "ポーカー"
      },
      "file": "web/boot.html",
      "icon": "assets/icon.svg",
      "service": {
        "port": 3481,
        "option": "port"
      }
    },
    "options": {
      "port": 3481,
      "tablePort": 3482
    }
  },
  "scripts": {
    "start": "go run ./cmd/magpie-poker --port 3481 --table-port 3482 --web-root .",
    "build": "go build -trimpath -ldflags \"-s -w\" -o bin/magpie-poker.exe ./cmd/magpie-poker",
    "test": "go test ./... && node --test test/skins.test.mjs"
  }
}
